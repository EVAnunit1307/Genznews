---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate, estimateReadTime } from '../lib/format';
import { categoryColor } from '../lib/categories';
import { resolveHero } from '../lib/heroImage';
import { SITE } from '../config';

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { title, dek, category, publishedAt, heroImage: heroImageName, readTime } = entry.data;
const heroImage = resolveHero(heroImageName);
const minutes = readTime ?? estimateReadTime(entry.body ?? '');
const c = categoryColor(category);
---

<section class="relative glow-warm px-6 md:px-12 lg:px-20 pt-14 pb-8">
  <div class="max-w-7xl mx-auto">
    <a
      href={`/article/${entry.id}`}
      data-article-card
      data-slug={entry.id}
      data-reveal
      class="group grid lg:grid-cols-12 gap-7 lg:gap-10 items-stretch tap"
    >
      <div
        class="lg:col-span-7 relative rounded-[1.5rem] overflow-hidden liquid-glass min-h-[280px] lg:min-h-[520px]"
      >
        {
          heroImage ? (
            <Image
              src={heroImage}
              alt={title}
              widths={[600, 1000, 1400]}
              sizes="(max-width: 1024px) 100vw, 58vw"
              class="absolute inset-0 w-full h-full object-cover"
              loading="eager"
            />
          ) : (
            <div
              class="absolute inset-0"
              style={`background: linear-gradient(135deg, ${c.from}, ${c.to})`}
            />
          )
        }
        <div
          class="absolute top-5 left-5 liquid-glass rounded-full px-3 py-1 text-[11px] font-body inline-flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 rounded-full" style={`background:${c.dot}`}></span>
          <span class="text-white/85">Lead story</span>
        </div>
        {/* trending flag — revealed by SocialProof.astro when this is the hottest */}
        <span
          data-trending
          hidden
          class="trending-chip absolute top-5 right-5 rounded-full px-3 py-1 text-[11px] uppercase tracking-[0.12em] font-body font-semibold text-white inline-flex items-center gap-1"
        >
          🔥 Trending
        </span>
      </div>

      <div class="lg:col-span-5 flex flex-col justify-center">
        <div class="text-[11px] uppercase tracking-[0.18em] font-body mb-4">
          <span style={`color:${c.label}`}>{category}</span>
          <span class="text-white/45"> · {formatDate(publishedAt)}</span>
        </div>
        <h2
          class="font-heading italic text-white text-4xl md:text-5xl lg:text-[3.4rem] leading-[0.95] tracking-[-2px] group-hover:text-white/90 transition-colors"
        >
          {title}
        </h2>
        {
          dek && (
            <p class="mt-5 text-base text-white/65 font-body font-light leading-relaxed">{dek}</p>
          )
        }
        <div class="mt-7 flex items-center gap-3">
          <div
            class="w-10 h-10 liquid-glass rounded-full flex items-center justify-center font-heading italic text-white"
          >
            {SITE.author.charAt(0)}
          </div>
          <div class="leading-tight">
            <div class="text-sm text-white font-body">{SITE.author}</div>
            <div class="text-xs text-white/55 font-body">{minutes} min read</div>
          </div>
          <span class="ml-auto inline-flex items-center gap-3">
            {/* real reaction count — injected by SocialProof.astro when > 0 */}
            <span
              data-social-proof
              hidden
              class="social-proof inline-flex items-center gap-1"
            ></span>
            <span
              class="liquid-glass-strong rounded-full px-4 py-2 text-sm text-white font-medium inline-flex items-center gap-2 whitespace-nowrap"
            >
              Read
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
              </svg>
            </span>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
