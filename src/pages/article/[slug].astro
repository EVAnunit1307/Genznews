---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.tsx';
import ReadingProgress from '../../components/ReadingProgress.tsx';
import Reactions from '../../components/Reactions.tsx';
import Comments from '../../components/Comments.tsx';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { SITE } from '../../config';
import { formatDate, formatDateShort, estimateReadTime, categorySlug } from '../../lib/format';
import { categoryColor } from '../../lib/categories';

export async function getStaticPaths() {
  const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );
  return all.map((entry) => {
    const sameCat = all.filter(
      (a) => a.id !== entry.id && a.data.category === entry.data.category
    );
    const others = all.filter(
      (a) => a.id !== entry.id && a.data.category !== entry.data.category
    );
    const related = [...sameCat, ...others].slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { title, dek, category, publishedAt, updatedAt, heroImage, readTime, tags } = entry.data;

const minutes = readTime ?? estimateReadTime(entry.body ?? '');
const dateFmt = formatDate(publishedAt);
const c = categoryColor(category);

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Guarantee the OG image is emitted in the build (preserve aspect ratio).
const ogImg = heroImage ? await getImage({ src: heroImage, width: 1200 }) : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: dek ?? title,
  datePublished: publishedAt.toISOString(),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  author: { '@type': 'Person', name: SITE.author, sameAs: [SITE.linkedin] },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: canonical,
  ...(ogImg ? { image: new URL(ogImg.src, Astro.site).href } : {}),
};
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={dek ?? title}
  ogImage={ogImg?.src}
  ogType="article"
  publishedTime={publishedAt.toISOString()}
  structuredData={structuredData}
>
  <ReadingProgress client:idle />

  <article class="min-h-screen bg-ink">
    {/* minimal top bar */}
    <div class="mx-auto max-w-3xl px-6 md:px-8 pt-8 flex items-center justify-between">
      <a
        href="/"
        class="font-heading italic text-white text-2xl leading-none inline-flex items-center gap-2 active:opacity-70 transition-opacity"
        style="min-height:44px"
      >
        <span
          class="liquid-glass w-9 h-9 rounded-full inline-flex items-center justify-center -mt-0.5"
          >
          <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M3.6 12h16.8" /><path d="M5 7.4h14" /><path d="M5 16.6h14" /><ellipse cx="12" cy="12" rx="4.5" ry="9" />
          </svg>
        </span>
      </a>
      <ShareButton client:visible title={title} url={canonical} />
    </div>

    <div class="mx-auto max-w-3xl px-6 md:px-8 pt-10 pb-24" data-pagefind-body>
      {/* eyebrow */}
      <div class="text-[11px] uppercase tracking-[0.18em] text-white/60 font-body mb-5">
        <a
          href={`/${categorySlug(category)}`}
          class="hover:text-white transition-colors"
          style={`color:${c.label}`}
        >
          {category}
        </a>
        · {dateFmt} · {minutes} min read
      </div>

      {/* headline */}
      <h1
        class="font-heading italic text-white text-4xl sm:text-5xl md:text-[3.6rem] leading-[0.95] tracking-[-2px] mb-5"
      >
        {title}
      </h1>

      {dek && (
        <p class="font-body font-light text-white/70 text-lg md:text-xl leading-relaxed mb-8">
          {dek}
        </p>
      )}

      {/* byline row */}
      <div class="flex items-center gap-3 mb-9 pb-8 border-b border-white/10">
        <div
          class="w-10 h-10 liquid-glass rounded-full flex items-center justify-center font-heading italic text-white text-lg"
        >
          {SITE.author.charAt(0)}
        </div>
        <div class="leading-tight">
          <div class="text-sm text-white font-body">{SITE.author}</div>
          <div class="text-xs text-white/55 font-body">
            {updatedAt ? `Updated ${formatDateShort(updatedAt)}` : dateFmt}
          </div>
        </div>
      </div>

      {/* hero */}
      {heroImage && (
        <Image
          src={heroImage}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 768px"
          class="w-full rounded-[1.25rem] mb-10"
          loading="eager"
          fetchpriority="high"
        />
      )}

      {/* body */}
      <div class="article-prose">
        <Content />
      </div>

      {/* tags */}
      {tags && tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-white/10 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span
              class="liquid-glass rounded-full px-3 py-1.5 text-[11px] text-white/60 font-body"
            >
              #{t}
            </span>
          ))}
        </div>
      )}

      {/* interactive footer — excluded from the search index */}
      <div data-pagefind-ignore>
        {/* author sign-off — reinforces the solo-magazine voice + next actions */}
        <div class="mt-14 liquid-glass rounded-[1.25rem] p-6 md:p-7">
          <div class="text-[10px] uppercase tracking-[0.18em] text-white/55 font-body mb-5">
            Who wrote this
          </div>
          <div class="flex items-start gap-4">
            <div
              class="w-14 h-14 shrink-0 rounded-full liquid-glass-strong flex items-center justify-center font-heading italic text-white text-2xl"
            >
              {SITE.author.charAt(0)}
            </div>
            <div class="min-w-0">
              <div
                class="font-heading italic text-white text-2xl tracking-[-0.5px] leading-none mb-1"
              >
                {SITE.author}
              </div>
              <div class="text-[12px] text-white/55 font-body mb-3">{SITE.authorRole}</div>
              <p class="text-sm text-white/70 font-body font-light leading-relaxed">
                {SITE.authorBio}
              </p>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <a
                  href={SITE.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full px-4 text-[12px] font-body text-white inline-flex items-center gap-1.5 liquid-glass tap"
                  style="min-height:44px"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
                  </svg>
                  LinkedIn
                </a>
                <a
                  href="/#newsletter"
                  class="rounded-full px-4 text-[12px] font-body text-white inline-flex items-center liquid-glass tap"
                  style="min-height:44px"
                >
                  Get the newsletter
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* reactions — expressive, low-friction engagement at the end of the read */}
        <div class="mt-12 flex flex-col items-center gap-4">
          <p class="text-[11px] uppercase tracking-[0.18em] text-white/55 font-body">
            Your take?
          </p>
          <Reactions client:visible slug={entry.id} />
        </div>

        <RelatedArticles items={related} />

        <Comments client:visible slug={entry.id} />

        <a
          href="/"
          class="mt-14 inline-flex items-center gap-2 text-sm text-white/60 font-body active:opacity-70 transition-opacity"
          style="min-height:44px"
        >
          ← Back to genzthinks
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
