---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicNav from '../components/TopicNav.astro';
import NewsletterMini from '../components/NewsletterMini.tsx';
import SocialProof from '../components/SocialProof.astro';
import Footer from '../components/Footer.astro';
import { CATEGORIES, SITE } from '../config';
import { categorySlug } from '../lib/format';
import { categoryColor } from '../lib/categories';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  return CATEGORIES.map((cat) => {
    const articles = all
      .filter((a) => a.data.category === cat)
      .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
    return { params: { category: categorySlug(cat) }, props: { category: cat, articles } };
  });
}

interface Props {
  category: string;
  articles: CollectionEntry<'articles'>[];
}
const { category, articles } = Astro.props;
const c = categoryColor(category);
---

<BaseLayout
  title={`${category} — ${SITE.name}`}
  description={`${category} stories from ${SITE.name}.`}
>
  <div class="min-h-screen bg-ink">
    <header
      class="relative px-6 md:px-12 lg:px-20 pt-10 pb-8"
      style={`background: radial-gradient(46% 120% at 8% -12%, ${c.glow}, transparent 60%)`}
    >
      <div class="max-w-7xl mx-auto">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-white/70 font-body hover:text-white tap mb-8"
          style="min-height:44px"
        >
          <span class="liquid-glass w-9 h-9 rounded-full inline-flex items-center justify-center -mt-0.5">
            <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M3.6 12h16.8" /><path d="M5 7.4h14" /><path d="M5 16.6h14" /><ellipse cx="12" cy="12" rx="4.5" ry="9" />
            </svg>
          </span>
          Home
        </a>
        <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] font-body mb-3">
          <span class="w-1.5 h-1.5 rounded-full" style={`background:${c.dot}`}></span>
          <span style={`color:${c.label}`}>Topic</span>
        </div>
        <h1 class="font-heading italic text-white text-6xl md:text-7xl tracking-[-2px] leading-[0.9]">
          {category}
        </h1>
        <p class="mt-4 text-sm text-white/55 font-body">
          {articles.length} {articles.length === 1 ? 'story' : 'stories'}
        </p>

        {/* cross-topic browsing — turns the category pages into a real system */}
        <div class="mt-8">
          <TopicNav active={categorySlug(category)} />
        </div>
      </div>
    </header>

    <section class="px-6 md:px-12 lg:px-20 pb-24">
      <div class="max-w-7xl mx-auto">
        {
          articles.length ? (
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {articles.map((entry, i) => (
                <ArticleCard entry={entry} index={i} />
              ))}
            </div>
          ) : (
            <div class="py-20 text-center flex flex-col items-center" data-reveal>
              <span class="liquid-glass w-14 h-14 rounded-full inline-flex items-center justify-center mb-6" style={`box-shadow: inset 0 0 0 1px ${c.softBorder}, 0 0 40px -8px ${c.glow}`}>
                <svg class="h-6 w-6" style={`color:${c.label}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" /><path d="M3.6 12h16.8" /><path d="M5 7.4h14" /><path d="M5 16.6h14" /><ellipse cx="12" cy="12" rx="4.5" ry="9" />
                </svg>
              </span>
              <p class="font-heading italic text-white/90 text-3xl md:text-4xl tracking-[-0.5px] mb-2">
                Nothing filed under {category} yet.
              </p>
              <p class="text-sm text-white/60 font-body max-w-sm mx-auto mb-7">
                New writing lands here first. Until then, explore the latest across every topic.
              </p>
              <a
                href="/#feed"
                class="liquid-glass-strong rounded-full px-5 text-sm font-medium text-white inline-flex items-center gap-2 tap"
                style="min-height:46px"
              >
                Read the latest
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          )
        }
      </div>
    </section>

    <SocialProof />

    {/* keep browsers from dead-ending — offer the newsletter before the footer */}
    <section class="px-6 md:px-12 lg:px-20 pb-24">
      <div class="max-w-md mx-auto">
        <NewsletterMini client:visible />
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
