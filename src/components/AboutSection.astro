---
import { SITE } from '../config';
// About Donya — the writer. Bio + LinkedIn come from SITE in src/config.ts.
---

<section id="about" class="relative bg-black px-6 md:px-12 lg:px-20 py-24 border-t border-white/[0.06] scroll-mt-16">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-14 lg:gap-16 items-start">
    <div>
      <div class="text-[11px] uppercase tracking-[0.2em] text-white/40 font-body mb-6" data-reveal>
        // About
      </div>
      <h2
        class="font-heading italic text-white text-5xl md:text-[3.6rem] tracking-[-2px] leading-[0.93] mb-8"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        One person, writing the news I wish existed.
      </h2>
      <div
        class="space-y-5 text-white/60 font-body font-light text-base leading-relaxed max-w-lg"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <p>
          I'm a Political Science &amp; Philosophy student at the University of Ottawa — and I work
          inside the rooms where policy actually gets made, on Parliament Hill and with the Young
          Liberals of Canada. The news gets written <em>about</em> my generation, rarely for us, and
          almost never by someone who has to live with the results.
        </p>
        <p>
          So this is my version: original writing on the policy, politics, climate, and culture
          shaping us — from someone who's actually in the room, in plain language, with receipts.
        </p>
        <p class="text-white/45">Independent. No VC, no algorithm, no team of ghostwriters. Just me.</p>
      </div>
    </div>

    <div class="liquid-glass rounded-[1.5rem] p-8 md:p-10" data-reveal style="--reveal-delay: 100ms">
      <div class="text-[10px] uppercase tracking-[0.2em] text-white/45 font-body mb-7">// Who's writing</div>
      <div class="flex items-start gap-5 mb-7">
        <div
          class="w-[4.5rem] h-[4.5rem] rounded-full shrink-0 flex items-center justify-center text-2xl font-heading italic text-white liquid-glass-strong"
        >
          {SITE.author.charAt(0).toUpperCase()}
        </div>
        <div class="pt-1">
          <div class="font-heading italic text-white text-2xl md:text-3xl tracking-[-0.5px] leading-none mb-1">
            {SITE.author}
          </div>
          <div class="text-[12px] text-white/45 font-body">{SITE.authorRole}</div>
        </div>
      </div>

      <blockquote
        class="text-[15px] text-white/70 font-body font-light leading-relaxed mb-7 border-l-2 pl-4"
        style="border-color: rgba(255,45,45,0.6)"
      >
        “I'm not a demographic to be solved. Neither are you. We're the people who have to actually
        live in the world these decisions build — so we should be the ones writing about it.”
      </blockquote>

      <div class="flex flex-wrap items-center gap-3 pt-5 border-t border-white/[0.08]">
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full px-4 text-[12px] font-body text-white inline-flex items-center gap-1.5 liquid-glass tap"
          style="min-height:44px"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
          </svg>
          LinkedIn
        </a>
        <a
          href="#newsletter"
          class="rounded-full px-4 text-[12px] font-body text-white inline-flex items-center liquid-glass tap"
          style="min-height:44px"
        >
          Get the newsletter
        </a>
        <a
          href="#feed"
          class="text-[12px] text-white/45 font-body hover:text-white transition-colors inline-flex items-center gap-1"
        >
          Read the latest
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7" /><path d="M7 7h10v10" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
