# Copy to `.env.local` for local `vercel dev`, and add these in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real values — .env* is gitignored.

# Finnhub — hero stock ticker (https://finnhub.io/dashboard)
FINNHUB_KEY=

# Buttondown — newsletter signups (https://buttondown.email/settings/api)
BUTTONDOWN_KEY=

# Upstash Redis / Vercel KV — article likes.
# Set automatically by the Vercel "Upstash for Redis" (or KV) integration,
# or paste from the Upstash console. Either KV_* or UPSTASH_* names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
