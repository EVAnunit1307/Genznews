---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import TopicFilter from './TopicFilter.tsx';
import NewsletterMini from './NewsletterMini.tsx';
import SocialProof from './SocialProof.astro';
import { TOPICS } from '../config';
import { categoryColor } from '../lib/categories';
import site from '../data/site.json';

interface Props {
  articles: CollectionEntry<'articles'>[];
  recent?: CollectionEntry<'articles'>[];
}
const { articles } = Astro.props;
const topics = TOPICS.filter((t) => t.id !== 'all');
---

<section id="feed" class="relative bg-ink px-6 md:px-12 lg:px-20 pt-6 pb-24 scroll-mt-16">
  <div class="max-w-7xl mx-auto">
    {/* topic filter */}
    <div class="flex justify-center mb-8">
      <TopicFilter client:idle />
    </div>

    <div
      class="flex items-center justify-between mb-6 pb-4 border-b border-white/[0.08]"
      data-reveal
    >
      <h2 class="font-heading italic text-white text-3xl md:text-4xl tracking-[-1px] leading-none">
        {site.feed.heading}
      </h2>
      <span class="text-[11px] text-white/55 font-body inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-live"></span>
        <span data-feed-count>
          {articles.length} {articles.length === 1 ? 'story' : 'stories'}
        </span>
      </span>
    </div>

    <div class="grid lg:grid-cols-12 gap-x-10">
      <div class="lg:col-span-8">
        <div class="grid sm:grid-cols-2 gap-5">
          {articles.map((entry, i) => <ArticleCard entry={entry} index={i} />)}
        </div>
        <div
          data-feed-empty
          style="display:none"
          class="py-16 text-center text-white/55 font-body text-sm"
        >
          No stories in this topic yet — check back soon.
        </div>
        {articles.length === 0 && (
          <div class="py-20 text-center">
            <p class="font-heading italic text-white/85 text-3xl tracking-[-0.5px] mb-2">
              The first story is on its way.
            </p>
            <p class="text-sm text-white/60 font-body max-w-sm mx-auto">
              Subscribe below and you'll be the first to read it.
            </p>
          </div>
        )}
      </div>

      <aside
        class="lg:col-span-4 flex flex-col gap-5 mt-8 lg:mt-0 lg:sticky lg:top-6 lg:self-start"
      >
        {/* Browse by topic — colorful + tappable, built for scan-first browsing */}
        <div class="liquid-glass rounded-[1.25rem] p-5" data-reveal>
          <div class="text-[10px] uppercase tracking-[0.18em] text-white/55 font-body mb-4">
            Browse by topic
          </div>
          <div class="grid grid-cols-2 gap-2">
            {
              topics.map((t) => {
                const c = categoryColor(t.label);
                return (
                  <a
                    href={`/${t.id}`}
                    class="topic-tile group rounded-xl px-3 py-2.5 flex items-center gap-2 tap"
                    style={`--tile:${c.soft}; --tile-border:${c.softBorder}; --tile-hover:${c.glow}`}
                  >
                    <span class="w-2 h-2 rounded-full shrink-0" style={`background:${c.dot}`} />
                    <span class="text-[13px] text-white/85 font-body leading-tight group-hover:text-white transition-colors">
                      {t.label}
                    </span>
                  </a>
                );
              })
            }
          </div>
        </div>

        <div id="newsletter" class="scroll-mt-16" data-reveal>
          <NewsletterMini client:visible />
        </div>
      </aside>
    </div>
  </div>
  <SocialProof />
</section>
