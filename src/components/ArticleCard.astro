---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { relativeTime, estimateReadTime } from '../lib/format';
import { categoryColor } from '../lib/categories';

interface Props {
  entry: CollectionEntry<'articles'>;
  index?: number;
}
const { entry, index = 0 } = Astro.props;
const { title, dek, category, publishedAt, heroImage, readTime } = entry.data;
const minutes = readTime ?? estimateReadTime(entry.body ?? '');
const c = categoryColor(category);
---

<a
  href={`/article/${entry.id}`}
  data-article-card
  data-slug={entry.id}
  data-category={category}
  data-reveal
  style={`--reveal-delay:${(index % 4) * 60}ms; --cat-glow:${c.glow}`}
  class="cat-card group block liquid-glass rounded-[1.25rem] overflow-hidden tap"
>
  <div class="relative aspect-[16/10] overflow-hidden">
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt={title}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, 45vw"
          class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div
          class="w-full h-full flex items-center justify-center"
          style={`background: linear-gradient(145deg, ${c.from}, ${c.to})`}
        >
          <span class="font-heading italic text-4xl" style={`color: ${c.label}`}>
            {category.charAt(0)}
          </span>
        </div>
      )
    }
    {/* category chip pinned on the image — instantly scannable */}
    <span
      class="absolute top-3 left-3 rounded-full px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] font-body font-semibold backdrop-blur-md"
      style={`color:${c.label}; background:${c.soft}; box-shadow: inset 0 0 0 1px ${c.softBorder}`}
    >
      {category}
    </span>
    {/* trending flag — revealed by SocialProof.astro only on the hottest card */}
    <span
      data-trending
      hidden
      class="trending-chip absolute top-3 right-3 rounded-full px-2.5 py-1 text-[10px] uppercase tracking-[0.14em] font-body font-semibold text-white inline-flex items-center gap-1"
    >
      🔥 Trending
    </span>
  </div>

  <div class="p-5">
    <h3
      class="font-heading text-white text-2xl leading-[1.08] tracking-[-0.5px] mb-2 group-hover:text-white/85 transition-colors"
    >
      {title}
    </h3>

    {
      dek && (
        <p class="text-sm text-white/60 font-body font-light leading-relaxed line-clamp-2">{dek}</p>
      )
    }

    <div class="mt-4 flex items-center gap-2 text-[11px] text-white/55 font-body">
      <span>{relativeTime(publishedAt)}</span>
      <span>·</span>
      <span>{minutes} min read</span>
      <span class="ml-auto inline-flex items-center gap-2.5">
        {/* real reaction count — injected by SocialProof.astro when > 0 */}
        <span data-social-proof hidden class="social-proof inline-flex items-center gap-1"></span>
        <svg
          class="h-4 w-4 text-white/25 group-hover:text-white/60 transition-colors"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
        </svg>
      </span>
    </div>
  </div>
</a>
