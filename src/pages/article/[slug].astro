---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.tsx';
import ReadingProgress from '../../components/ReadingProgress.tsx';
import LikeButton from '../../components/LikeButton.tsx';
import Giscus from '../../components/Giscus.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { SITE } from '../../config';
import { formatDate, formatDateShort, estimateReadTime } from '../../lib/format';

export async function getStaticPaths() {
  const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );
  return all.map((entry) => {
    const sameCat = all.filter(
      (a) => a.id !== entry.id && a.data.category === entry.data.category
    );
    const others = all.filter(
      (a) => a.id !== entry.id && a.data.category !== entry.data.category
    );
    const related = [...sameCat, ...others].slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { title, dek, category, publishedAt, updatedAt, heroImage, readTime, tags } = entry.data;

const minutes = readTime ?? estimateReadTime(entry.body ?? '');
const dateFmt = formatDate(publishedAt);

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Guarantee the OG image is emitted in the build (preserve aspect ratio).
const ogImg = heroImage ? await getImage({ src: heroImage, width: 1200 }) : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: dek ?? title,
  datePublished: publishedAt.toISOString(),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: canonical,
  ...(ogImg ? { image: new URL(ogImg.src, Astro.site).href } : {}),
};
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={dek ?? title}
  ogImage={ogImg?.src}
  ogType="article"
  publishedTime={publishedAt.toISOString()}
  structuredData={structuredData}
>
  <ReadingProgress client:idle />

  <article class="min-h-screen bg-black">
    {/* minimal top bar */}
    <div class="mx-auto max-w-3xl px-6 md:px-8 pt-8 flex items-center justify-between">
      <a
        href="/"
        class="font-heading italic text-white text-2xl leading-none inline-flex items-center gap-2 active:opacity-70 transition-opacity"
        style="min-height:44px"
      >
        <span
          class="liquid-glass w-9 h-9 rounded-full inline-flex items-center justify-center text-lg -mt-0.5"
          >g</span
        >
      </a>
      <ShareButton client:visible title={title} url={canonical} />
    </div>

    <div class="mx-auto max-w-3xl px-6 md:px-8 pt-10 pb-24" data-pagefind-body>
      {/* eyebrow */}
      <div class="text-[11px] uppercase tracking-[0.18em] text-white/55 font-body mb-5">
        {category} · {dateFmt} · {minutes} min read
      </div>

      {/* headline */}
      <h1
        class="font-heading italic text-white text-4xl sm:text-5xl md:text-[3.6rem] leading-[0.95] tracking-[-2px] mb-5"
      >
        {title}
      </h1>

      {dek && (
        <p class="font-body font-light text-white/70 text-lg md:text-xl leading-relaxed mb-8">
          {dek}
        </p>
      )}

      {/* byline row */}
      <div class="flex items-center gap-3 mb-9 pb-8 border-b border-white/10">
        <div
          class="w-10 h-10 liquid-glass rounded-full flex items-center justify-center font-heading italic text-white text-lg"
        >
          {SITE.author.charAt(0)}
        </div>
        <div class="leading-tight">
          <div class="text-sm text-white font-body">{SITE.author}</div>
          <div class="text-xs text-white/50 font-body">
            {updatedAt ? `Updated ${formatDateShort(updatedAt)}` : dateFmt}
          </div>
        </div>
      </div>

      {/* hero */}
      {heroImage && (
        <Image
          src={heroImage}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 768px"
          class="w-full rounded-[1.25rem] mb-10"
          loading="eager"
        />
      )}

      {/* body */}
      <div class="article-prose">
        <Content />
      </div>

      {/* tags */}
      {tags && tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-white/10 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span
              class="liquid-glass rounded-full px-3 py-1.5 text-[11px] text-white/60 font-body"
            >
              #{t}
            </span>
          ))}
        </div>
      )}

      {/* interactive footer — excluded from the search index */}
      <div data-pagefind-ignore>
        {/* like — engagement at the end of the read */}
        <div class="mt-12 flex flex-col items-center gap-3">
          <p class="text-[11px] uppercase tracking-[0.18em] text-white/40 font-body">
            Did this land?
          </p>
          <LikeButton client:visible slug={entry.id} />
        </div>

        <RelatedArticles items={related} />

        <Giscus term={entry.id} />

        <a
          href="/"
          class="mt-14 inline-flex items-center gap-2 text-sm text-white/60 font-body active:opacity-70 transition-opacity"
          style="min-height:44px"
        >
          ← Back to genzthinks
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
