# NewsAPI.org — https://newsapi.org (free tier, server-side only — CORS blocked in browser)
NEWSAPI_KEY=your_newsapi_key_here

# NY Times — https://developer.nytimes.com (free, register + enable "Top Stories API")
# Takes ~5 min: create app → enable Top Stories → copy key
NYTIMES_KEY=your_nytimes_key_here

# The Guardian — https://open-platform.theguardian.com (free, "test" works for limited access)
# Full key: register at open-platform.theguardian.com/access/register
# NOTE: Guardian key format is a UUID like xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#       Do NOT use the NewsAPI key here — it's a different service
GUARDIAN_KEY=test

# JWT signing secret — generate a random 32-char string for production
SECRET_KEY=change-this-in-production-use-random-32-chars

# SQLite database file path (relative to Backend/)
DATABASE_URL=sqlite+aiosqlite:///./axis.db

NEWS_CACHE_TTL_MINUTES=30
PORT=8000
